{
    "name": "@mcma/azure-logger",
    "version": "2.0.0",
    "description": "Azure Functions host logging with optional Application Insights SDK integration",
    "engines": {
        "node": ">=22.0.0"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./application-insights": {
            "types": "./dist/application-insights.d.ts",
            "import": "./dist/application-insights.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "test": "node --test ../../scripts/azure-functions-logger.test.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ebu/mcma-libraries.git",
        "directory": "azure/logger"
    },
    "keywords": [
        "ebu",
        "mcma",
        "azure"
    ],
    "author": "Evan Verney-Fink <evan@triskel-inc.com>",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/ebu/mcma-libraries/issues"
    },
    "homepage": "https://github.com/ebu/mcma-libraries#readme",
    "peerDependencies": {
        "@mcma/core": "2.0.0",
        "applicationinsights": "^3.17.0"
    },
    "peerDependenciesMeta": {
        "applicationinsights": {
            "optional": true
        }
    },
    "devDependencies": {
        "applicationinsights": "^3.17.0",
        "@azure/functions": "^4.16.5",
        "@mcma/core": "2.0.0",
        "@types/node": "^22.20.5"
    }
}
